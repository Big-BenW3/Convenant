# Solana keypairs / program upgrade authorities — NEVER commit these.
# The program keypair at anchor/target/deploy/ controls the deployed contract;
# leaking it lets anyone upgrade the program.
*-keypair.json
*-upgrade-buffer.json
keypair.json
*.keypair
*.pem

# dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/
build/

# typescript
*.tsbuildinfo
next-env.d.ts

# anchor build artifacts
/anchor/.anchor/
/anchor/target/

# solana local validator
test-ledger/

# Env
.env
.env.*
!.env.example

# Vercel
.vercel

# Misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/
